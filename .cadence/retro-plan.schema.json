{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nik190799.github.io/cadence/schemas/retro-plan.schema.json",
  "title": "Cadence retro plan (plan.json / applied.json)",
  "description": "What tool/ladder.py plan proposes for the rolling retro PR, and (applied: true) what tool/ladder.py apply actually changed. Every string is a key, path, id, enum or fixed-template text: no model text and no excerpts (docs/LEARNING.md).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "plan_sha",
    "base_sha",
    "generated_at",
    "mode",
    "applied",
    "verify_required",
    "transitions",
    "skipped",
    "needs_human",
    "replay",
    "metrics"
  ],
  "properties": {
    "schema": { "const": "cadence.retro-plan/1" },
    "plan_sha": { "$ref": "#/$defs/sha256" },
    "base_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "generated_at": { "$ref": "#/$defs/ts" },
    "mode": { "enum": ["observe", "on", "eval-sandbox"] },
    "applied": { "type": "boolean" },
    "verify_required": { "type": "boolean" },
    "transitions": {
      "type": "array",
      "maxItems": 13,
      "items": { "$ref": "#/$defs/transition" }
    },
    "skipped": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["class_key", "why"],
        "properties": {
          "class_key": { "$ref": "#/$defs/class_key" },
          "why": { "type": "string", "pattern": "^[a-z0-9-]{1,40}$" }
        }
      }
    },
    "needs_human": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "why"],
        "properties": {
          "key": {
            "type": "string",
            "maxLength": 200,
            "pattern": "^[A-Za-z0-9_./@+:>-]{1,200}$"
          },
          "why": {
            "enum": [
              "needs-words",
              "seed-rule-on-main",
              "package-edge",
              "unsupported-language",
              "emit-failed",
              "regressed",
              "verify-failed"
            ]
          }
        }
      }
    },
    "replay": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fixture", "rule_id", "fired"],
        "properties": {
          "fixture": { "type": "string", "pattern": "^[0-9a-f]{8}$" },
          "rule_id": {
            "type": ["string", "null"],
            "pattern": "^[LB]-[0-9a-f]{8}$"
          },
          "fired": { "type": "boolean" }
        }
      }
    },
    "metrics": { "type": ["object", "null"] }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "ts": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "uuid": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "class_key": {
      "type": "string",
      "maxLength": 200,
      "pattern": "^(import-edge|guarded|missing-test|test|edit|review|gate|agent|pr):[A-Za-z0-9_./@+:>-]{1,180}$"
    },
    "safe_glob": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.@*-][A-Za-z0-9_.@/*-]{0,199}$"
    },
    "sample": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run",
        "patch",
        "patch_sha256",
        "path",
        "line_no",
        "import_line",
        "language",
        "where",
        "forbidden_pattern"
      ],
      "properties": {
        "run": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}-[1-9][0-9]{0,9}$"
        },
        "patch": {
          "type": "string",
          "pattern": "^patches/[A-Za-z0-9][A-Za-z0-9._-]{0,127}-[1-9][0-9]{0,9}\\.patch$"
        },
        "patch_sha256": { "$ref": "#/$defs/sha256" },
        "path": { "type": "string", "pattern": "^[A-Za-z0-9_.@+/-]{1,300}$" },
        "line_no": { "type": "integer", "minimum": 1 },
        "import_line": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[\\t -~]+$"
        },
        "language": { "enum": ["ts", "tsx", "js", "py", "dart"] },
        "where": { "$ref": "#/$defs/safe_glob" },
        "forbidden_pattern": { "$ref": "#/$defs/safe_glob" }
      }
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lesson_id",
        "class_key",
        "from",
        "to",
        "reason",
        "issues",
        "occurrences",
        "evidence",
        "text",
        "sample",
        "emit"
      ],
      "properties": {
        "lesson_id": { "type": "string", "pattern": "^L-[0-9a-f]{8}$" },
        "class_key": { "$ref": "#/$defs/class_key" },
        "from": { "enum": ["note", "pattern", "check", "retired", "suppressed"] },
        "to": { "enum": ["pattern", "check", "retired", "suppressed"] },
        "reason": {
          "enum": [
            "promote",
            "emit-fallback",
            "verify-fallback",
            "broken",
            "blocks-merged-code",
            "stale",
            "dormant",
            "cap",
            "human-removed",
            "rejected-twice"
          ]
        },
        "issues": {
          "type": "array",
          "maxItems": 5,
          "items": { "type": "integer", "minimum": 1 }
        },
        "occurrences": { "type": "integer", "minimum": 0 },
        "evidence": {
          "type": "array",
          "maxItems": 5,
          "items": { "$ref": "#/$defs/uuid" }
        },
        "text": {
          "type": ["string", "null"],
          "maxLength": 280,
          "pattern": "^[^\\r\\n]+$"
        },
        "sample": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/sample" }]
        },
        "alternates": {
          "description": "Further samples apply tries, in order, when the check cannot be proven on sample. Only in plan.json; applied.json never has it.",
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": { "$ref": "#/$defs/sample" }
        },
        "emit": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["exit", "fixture"],
              "properties": {
                "exit": { "type": "integer" },
                "fixture": {
                  "type": ["string", "null"],
                  "pattern": "^tests/fixtures/retro/[0-9a-f]{8}/$"
                }
              }
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "to": { "const": "check" } },
            "required": ["to"]
          },
          "then": { "properties": { "sample": { "$ref": "#/$defs/sample" } } }
        }
      ]
    }
  }
}
